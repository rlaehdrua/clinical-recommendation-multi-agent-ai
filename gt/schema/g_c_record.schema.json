{
 "$defs": {
  "Adjudication": {
   "additionalProperties": false,
   "description": "agreed: 두 라벨러 일치·확신도 3 / adjudicated: 판정자가 결정 / ambiguous: 판정자도 판정 불가 (주 지표 분모 제외)\n/ pending: 아직 판정 전 (동결 불가).",
   "properties": {
    "status": {
     "enum": [
      "agreed",
      "adjudicated",
      "ambiguous",
      "pending"
     ],
     "title": "Status",
     "type": "string"
    },
    "adjudicator_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Adjudicator Id"
    },
    "adjudicated_at": {
     "anyOf": [
      {
       "format": "date-time",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Adjudicated At"
    },
    "reason": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Reason"
    },
    "log_ref": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Log Ref"
    }
   },
   "required": [
    "status"
   ],
   "title": "Adjudication",
   "type": "object"
  },
  "Annotation_CriterionLabel_": {
   "additionalProperties": false,
   "properties": {
    "labeler_id": {
     "minLength": 1,
     "title": "Labeler Id",
     "type": "string"
    },
    "labeled_at": {
     "format": "date-time",
     "title": "Labeled At",
     "type": "string"
    },
    "confidence": {
     "maximum": 3,
     "minimum": 1,
     "title": "Confidence",
     "type": "integer"
    },
    "evidence_spans": {
     "default": [],
     "items": {
      "$ref": "#/$defs/Span"
     },
     "title": "Evidence Spans",
     "type": "array"
    },
    "note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Note"
    },
    "label": {
     "$ref": "#/$defs/CriterionLabel"
    }
   },
   "required": [
    "labeler_id",
    "labeled_at",
    "confidence",
    "label"
   ],
   "title": "Annotation[CriterionLabel]",
   "type": "object"
  },
  "CountryScope": {
   "additionalProperties": false,
   "properties": {
    "scoped": {
     "title": "Scoped",
     "type": "boolean"
    },
    "scope_unit": {
     "enum": [
      "institution_country",
      "patient_residence",
      "unclear",
      "not_applicable"
     ],
     "title": "Scope Unit",
     "type": "string"
    },
    "countries": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Countries",
     "type": "array"
    },
    "applies_when": {
     "default": "not_applicable",
     "enum": [
      "inside",
      "outside",
      "not_applicable"
     ],
     "title": "Applies When",
     "type": "string"
    },
    "note": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Note"
    }
   },
   "required": [
    "scoped",
    "scope_unit"
   ],
   "title": "CountryScope",
   "type": "object"
  },
  "CriterionInput": {
   "additionalProperties": false,
   "properties": {
    "trial_id": {
     "minLength": 1,
     "title": "Trial Id",
     "type": "string"
    },
    "criterion_id": {
     "minLength": 1,
     "title": "Criterion Id",
     "type": "string"
    },
    "criterion_text": {
     "minLength": 1,
     "title": "Criterion Text",
     "type": "string"
    },
    "trial_source": {
     "minLength": 1,
     "title": "Trial Source",
     "type": "string"
    },
    "parsed_store_ref": {
     "anyOf": [
      {
       "$ref": "#/$defs/FileRef"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "trial_id",
    "criterion_id",
    "criterion_text",
    "trial_source"
   ],
   "title": "CriterionInput",
   "type": "object"
  },
  "CriterionLabel": {
   "additionalProperties": false,
   "properties": {
    "interpretation": {
     "minLength": 1,
     "title": "Interpretation",
     "type": "string"
    },
    "country_scope": {
     "$ref": "#/$defs/CountryScope"
    },
    "applicability_condition": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Applicability Condition"
    },
    "needs_clinical_judgement": {
     "title": "Needs Clinical Judgement",
     "type": "boolean"
    },
    "structured": {
     "anyOf": [
      {
       "$ref": "#/$defs/StructuredReading"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "interpretation",
    "country_scope",
    "needs_clinical_judgement"
   ],
   "title": "CriterionLabel",
   "type": "object"
  },
  "FileRef": {
   "additionalProperties": false,
   "properties": {
    "path": {
     "minLength": 1,
     "title": "Path",
     "type": "string"
    },
    "sha256": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Sha256",
     "type": "string"
    }
   },
   "required": [
    "path",
    "sha256"
   ],
   "title": "FileRef",
   "type": "object"
  },
  "NeedsExpert": {
   "additionalProperties": false,
   "properties": {
    "flag": {
     "title": "Flag",
     "type": "boolean"
    },
    "reason": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Reason"
    }
   },
   "required": [
    "flag"
   ],
   "title": "NeedsExpert",
   "type": "object"
  },
  "Source": {
   "additionalProperties": false,
   "description": "사례가 어디서 왔는지.",
   "properties": {
    "origin": {
     "enum": [
      "clinician_synthetic",
      "separated_llm_draft_reviewed",
      "deidentified_real",
      "provided_example",
      "ctgov_protocol",
      "fixture"
     ],
     "title": "Origin",
     "type": "string"
    },
    "detail": {
     "minLength": 1,
     "title": "Detail",
     "type": "string"
    },
    "author_id": {
     "minLength": 1,
     "title": "Author Id",
     "type": "string"
    },
    "author_independent_of_engine_work": {
     "title": "Author Independent Of Engine Work",
     "type": "boolean"
    },
    "created_at": {
     "format": "date-time",
     "title": "Created At",
     "type": "string"
    },
    "not_derived_from_existing_sets": {
     "title": "Not Derived From Existing Sets",
     "type": "boolean"
    }
   },
   "required": [
    "origin",
    "detail",
    "author_id",
    "author_independent_of_engine_work",
    "created_at",
    "not_derived_from_existing_sets"
   ],
   "title": "Source",
   "type": "object"
  },
  "Span": {
   "additionalProperties": false,
   "description": "원문(input.text 또는 기록) 안의 문자 오프셋 [start, end).",
   "properties": {
    "start": {
     "minimum": 0,
     "title": "Start",
     "type": "integer"
    },
    "end": {
     "minimum": 0,
     "title": "End",
     "type": "integer"
    }
   },
   "required": [
    "start",
    "end"
   ],
   "title": "Span",
   "type": "object"
  },
  "StructuredReading": {
   "additionalProperties": false,
   "properties": {
    "field": {
     "minLength": 1,
     "title": "Field",
     "type": "string"
    },
    "operator": {
     "enum": [
      ">=",
      ">",
      "<=",
      "<",
      "==",
      "!=",
      "in",
      "not_in"
     ],
     "title": "Operator",
     "type": "string"
    },
    "value": {
     "minLength": 1,
     "title": "Value",
     "type": "string"
    },
    "unit": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Unit"
    }
   },
   "required": [
    "field",
    "operator",
    "value"
   ],
   "title": "StructuredReading",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "item_id": {
   "minLength": 1,
   "title": "Item Id",
   "type": "string"
  },
  "needs_expert": {
   "$ref": "#/$defs/NeedsExpert"
  },
  "adjudication": {
   "$ref": "#/$defs/Adjudication"
  },
  "source": {
   "$ref": "#/$defs/Source"
  },
  "layer": {
   "const": "G-C",
   "title": "Layer",
   "type": "string"
  },
  "input": {
   "$ref": "#/$defs/CriterionInput"
  },
  "annotations": {
   "items": {
    "$ref": "#/$defs/Annotation_CriterionLabel_"
   },
   "minItems": 1,
   "title": "Annotations",
   "type": "array"
  },
  "final": {
   "anyOf": [
    {
     "$ref": "#/$defs/CriterionLabel"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  }
 },
 "required": [
  "item_id",
  "needs_expert",
  "adjudication",
  "source",
  "layer",
  "input",
  "annotations"
 ],
 "title": "CriterionRecord",
 "type": "object"
}
