From: 서연 (데이터) - P0-3 엔진 수정 제안 (적용하지 않음, 엔진 담당자 선우 승인 필요)
Subject: [제안] 국가 한정 문구가 있는 나이 기준이 불충족이면 규칙 엔진이 확정하지 않음

설명: docs/proposals/p0_3_region_condition.md
적용: git apply docs/proposals/p0_3_region_condition.patch
---
diff --git a/src/ctrec/tools/rule_engine.py b/src/ctrec/tools/rule_engine.py
index 361ee8e..628ec37 100644
--- a/src/ctrec/tools/rule_engine.py
+++ b/src/ctrec/tools/rule_engine.py
@@ -278,6 +278,11 @@ def _evaluate_age(rule: Rule, patient: PatientProfile) -> CriterionAssessment |
                    f"{shown} = {lo:.0f}~{hi:.0f}일, 기준 {target:g} {rule_unit} = {t:.0f}일 → {_ko(at_lo)}")
 
 
+# 국가·지역 한정 문구 ('in the USA', 'outside of the USA'). 환자 국가를 알 수 없으므로 이런 나이 기준이 불충족이면
+# 확정하지 않음 (P0-3, NCT06216301 I1 '≥22 years of age in the USA': USA 밖 20세가 확정 부적격이 되던 결함)
+_REGION_QUALIFIER = re.compile(r"\b(?:in|outside(?:\s+of)?)\s+(?:the\s+)?(?:USA|U\.S\.(?:A\.)?|US|United States)\b")
+
+
 def evaluate(rule: Rule, patient: PatientProfile, reference_date: str | None = None) -> CriterionAssessment | None:
     """reference_date: 판정 기준일(YYYY-MM-DD). 기간 조건이 붙은 검사 기준에만 씀. 없으면 config.reference_date()."""
     if not rule.structured_evaluable or not rule.field or not rule.operator:
@@ -285,7 +290,10 @@ def evaluate(rule: Rule, patient: PatientProfile, reference_date: str | None = N
     field = _norm(rule.field)
 
     if field == "age":
-        return _evaluate_age(rule, patient)
+        a = _evaluate_age(rule, patient)
+        if a is not None and a.holds == "no" and _REGION_QUALIFIER.search(rule.text or ""):
+            return None  # 지역 조건부 나이 기준 불충족: 국가 확인 전에는 판정하지 않음 (충족은 지역과 무관하게 그대로)
+        return a
 
     if field == "sex":
         if not rule.value or rule.operator not in ("==", "!="):
