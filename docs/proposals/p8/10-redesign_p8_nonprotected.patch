+    assert qa_guard.FLAG in shown["validation_flags"]  # 화면 기준 필드에 경계 표지 (패치 06의 validation_flags)
+    assert v["contract"]["criteria"] == [] and "활성(승인된) IR이 없어" in page
+    assert s.result()["qa_log"][0]["answer"] == a  # 비계약 답 자체는 기록에 남음 (삭제하지 않음)
