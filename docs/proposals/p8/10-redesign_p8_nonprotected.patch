+
+@pytest.mark.parametrize("text,quote,holds,ok", [
+    ("변함없이 임신 유지 중.", "변함없이 임신 유지 중", "yes", True),
+    ("변함없이 임신 유지 중.", "변함없이 임신 유지 중", "no", False),
