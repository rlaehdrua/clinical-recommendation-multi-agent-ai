+def test_mixed_polarity_sentence_is_split_by_clause():
+    """긍정·부정 공존: 절 단위로 극성을 봄. 수유 기준은 '수유 중' 절, 임신 기준은 '임신은 아니지만' 절."""
+    text = "임신은 아니지만 현재 수유 중입니다."
