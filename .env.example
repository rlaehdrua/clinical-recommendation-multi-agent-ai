# Claude API 키 (또는 `ant auth login` 프로필을 사용하면 비워둬도 됩니다)
ANTHROPIC_API_KEY=

# 사용할 모델 (기본값: claude-sonnet-5)
CTREC_MODEL=claude-sonnet-5

# 서버측 refusal fallback(대체 모델). 기본 0: 대체 모델의 판정·단가는 검증되지 않음 (docs/web_deployment.md 3절)
CTREC_FALLBACKS=0

# 웹 비용 모드: record(기본, 기록만) / enforce(비용 상한, 영속 원장 필요 - docs/web_budget_operations.md)
CTREC_WEB_METERING=record

# 웹 실제 AI 분석(유료 호출). 기본 0: API 키가 있어도 웹은 실제 호출을 하지 않음.
# 1로 켜려면 enforce + 비용 설정·원장 + 비밀번호(12자 이상) 등 모든 조건이 필요하고 별도 승인 후에만 (docs/team_local_setup.md)
CTREC_WEB_PAID_ENABLED=0

# 시험별 병렬 처리 개수
CTREC_MAX_WORKERS=4

# 배포 시 접속 비밀번호 (설정하면 브라우저에서 Basic 인증 창이 뜹니다. 아이디는 아무거나)
CTREC_PASSWORD=
