{
 "trial_id": "NCT07098338",
 "title": "A Study of Novel Combinations in Non-Small Cell Lung Cancer (NSCLC)",
 "target_population": "Adults with locally advanced or metastatic NSCLC enrolled into one of three sub-studies based on PD-L1 expression/actionable genomic alteration (AGA) status and line of therapy, receiving novel combinations including rilvegostomig, ramucirumab, and/or Dato-DXd.",
 "intervention_summary": "Rilvegostomig ± ramucirumab (Sub-study 1, PD-L1≥50% 1L non-AGA NSCLC); Rilvegostomig + ramucirumab (Sub-study 2, PD-L1 1-49% 1L non-AGA NSCLC); Dato-DXd + ramucirumab ± rilvegostomig (Sub-study 3, 2/3L AGA+ NSCLC).",
 "key_conditions": [
  "Locally advanced or metastatic NSCLC",
  "PD-L1 expression status",
  "Actionable genomic alterations (EGFR, ALK, other AGAs)",
  "Prior treatment history"
 ],
 "cohorts": [
  "Sub-study 1",
  "Sub-study 2",
  "Sub-study 3"
 ],
