  "trial_id": "NCT07087314",
  "title": "A Study of Anti-CD38 Monoclonal Antibody (SG301) Subcutaneous Injection in Children With Nephrotic Syndrome With Frequent Relapses or Steroid Dependence",
  "target_population": "Children aged 6-18 years with steroid-sensitive nephrotic syndrome exhibiting frequent relapses (FRNS) or steroid dependence (SDNS)",
  "intervention_summary": "SG301 (anti-CD38 monoclonal antibody) subcutaneous injection 10 mg/kg, weekly for 6 weeks then every 2 weeks for 3 doses (total 9 injections) over a 12-week treatment phase, with 40-week follow-up",
  "key_conditions": [
   "Nephrotic Syndrome in Children",
   "Frequently Relapsing Nephrotic Syndrome (FRNS)",
   "Steroid-Dependent Nephrotic Syndrome (SDNS)"
