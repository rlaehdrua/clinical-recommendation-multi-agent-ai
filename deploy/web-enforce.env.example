# B. enforce 운영 구성 — 대시보드에 넣을 값의 예시. 실제 비밀값을 이 파일에 적어 커밋하지 마세요.
# 아래 한도 값은 예시입니다. 운영자가 정해야 합니다. 가격 확인 표시(CTREC_WEB_PRICE_CONFIRMED)는 일부러 0으로 두었습니다:
# 배포 직전에 공식 가격표를 다시 확인한 사람만 1로 바꾸고 CTREC_WEB_PRICE_SOURCE에 확인 날짜를 적으세요.
# 점검: PYTHONPATH=src python scripts/check_web_deployment.py --render-yaml deploy/render.enforce.yaml --env-file <채운 파일>
ANTHROPIC_API_KEY=
CTREC_PASSWORD=
CTREC_WEB_METERING=enforce
CTREC_WEB_PAID_ENABLED=0   # 별도 승인 전까지 0. 1이어도 아래 조건(가격 확인·원장·비밀번호 등)을 모두 충족해야 허가
CTREC_FALLBACKS=0
CTREC_MODEL=claude-sonnet-5
CTREC_REQUIRE_HTTPS=1
CTREC_COOKIE_SECURE=1
CTREC_WEB_SAVE_OUTPUTS=0

# 원장: 영속 디스크 마운트 경로 아래 (deploy/render.enforce.yaml의 mountPath와 맞춤). 처음 한 번 init 필요
CTREC_WEB_BUDGET_LEDGER=/var/data/ctrec/web-ledger.db
CTREC_WEB_BUDGET_LEDGER_PERSISTENT=1   # 영속 디스크를 실제로 확인한 뒤에만 1
CTREC_WEB_BUDGET_SINGLE_INSTANCE=1     # 인스턴스 1개·워커 1개를 확인한 뒤에만 1
CTREC_WEB_BUDGET_PERIOD=day

# 실행 1건 한도 (예시)
CTREC_WEB_RUN_MAX_USD=3
CTREC_WEB_RUN_MAX_CALLS=60
CTREC_WEB_RUN_MAX_INPUT_TOKENS=1500000
CTREC_WEB_RUN_MAX_OUTPUT_TOKENS=300000
# 공용 한도 (예시, 기간당)
CTREC_WEB_SHARED_MAX_USD=30
CTREC_WEB_SHARED_MAX_CALLS=600
CTREC_WEB_SHARED_MAX_INPUT_TOKENS=15000000
CTREC_WEB_SHARED_MAX_OUTPUT_TOKENS=3000000

# claude-sonnet-5 단가 (USD / 100만 토큰). 공식 가격표 2026-10-15 확인값: 입력 2, 출력 10, 5분 캐시 쓰기 2.5, 캐시 읽기 0.2
CTREC_WEB_PRICE_MODEL=claude-sonnet-5
CTREC_WEB_PRICE_INPUT=2
CTREC_WEB_PRICE_OUTPUT=10
CTREC_WEB_PRICE_CACHE_WRITE=2.5
CTREC_WEB_PRICE_CACHE_READ=0.2
CTREC_WEB_PRICE_CONFIRMED=0
CTREC_WEB_PRICE_SOURCE=
