# A. 기본 배포 구성 (record) — 대시보드에 넣을 값의 예시. 실제 비밀값을 이 파일에 적어 커밋하지 마세요.
# 사용량을 기록만 하고 비용을 강제로 막지 않습니다. 유료 호출 허용을 뜻하지 않습니다.
# 점검: PYTHONPATH=src python scripts/check_web_deployment.py --target record --env-file <이 파일을 복사해 값을 채운 파일>
ANTHROPIC_API_KEY=            # 웹 전용 키. 비워 두면 분석이 시작되지 않음(유료 호출 없음)
CTREC_PASSWORD=               # 12자 이상. API 키가 있으면 필수 (record에는 비용 상한이 없음)
CTREC_WEB_METERING=record
CTREC_WEB_PAID_ENABLED=0       # record에서는 실제 AI 분석 불가 (1이어도 거부)
CTREC_FALLBACKS=0
CTREC_MODEL=claude-sonnet-5
CTREC_REQUIRE_HTTPS=1
CTREC_COOKIE_SECURE=1
CTREC_WEB_SAVE_OUTPUTS=0
